# ==========================================
# Exemplo de Variáveis de Ambiente (Sanitizado)
# Copie para .env e preencha no servidor
# ==========================================

# --- n8n ---
N8N_HOST=seu-dominio-ou-ip.exemplo.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=substitua_por_uma_chave_aleatoria_forte_32_chars
GENERIC_TIMEZONE=America/Recife

# --- WAHA (WhatsApp HTTP API) ---
WAHA_BASE_URL=http://waha-harpy:3000
WAHA_API_KEY=substitua_pela_sua_chave_api_waha

# --- Google Gemini API ---
GEMINI_API_KEY=substitua_pela_sua_chave_google_ai_studio

# --- PostgreSQL / Supabase ---
POSTGRES_HOST=aws-X-region.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.seu_project_ref
POSTGRES_PASSWORD=substitua_pela_senha_do_banco
